---
import { communityStats } from "../config/community";

export interface Stat {
  value: string;
  label: string;
  icon?: string;
}

export interface Testimonial {
  quote: string;
  author: string;
  role: string;
  company?: string;
}

export interface Props {
  stats?: Stat[];
  testimonials?: Testimonial[];
}

// Default stats if none provided
const defaultStats: Stat[] = [
  { value: communityStats.memberCount, label: "Developers" },
  { value: communityStats.meetupCount, label: "Meetups" },
  { value: communityStats.talksAndDemos, label: "Talks & Demos" },
  { value: communityStats.opportunities, label: "Opportunities" },
];

// Real feedback from Meetup.com reviews (anonymized)
const defaultTestimonials: Testimonial[] = [
  {
    quote:
      "Habe einen Ansatz zum Einstieg in Agentic Coding diskutiert und werde damit starten.",
    author: "Meetup #2 Attendee",
    role: "★★★★★",
  },
  {
    quote:
      "Good vibes :)",
    author: "Meetup #2 Attendee",
    role: "★★★★★",
  },
];

const { stats = defaultStats, testimonials = defaultTestimonials } =
  Astro.props;
---

<div class="social-proof-container">
  <!-- Stats Section -->
  <div class="stats-section">
    <div class="mx-auto max-w-6xl px-4">
      <div class="stats-grid">
        {
          stats.map(stat => (
            <div class="stat-item">
              <div class="stat-value">{stat.value}</div>
              <div class="stat-label">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <!-- Feedback Section -->
  <div class="feedback-section">
    <div class="mx-auto max-w-6xl px-4">
      <div class="text-center">
        <p
          class="text-base font-semibold uppercase tracking-[0.2em] text-gray-600"
        >
          Real Feedback
        </p>
        <h2 class="display-title mt-2">4.8 ★ from 78 Reviews</h2>
        <div class="feedback-tags">
          <div class="feedback-tag">
            <div class="tag-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <span class="tag-label">Engaging</span>
          </div>
          <div class="feedback-tag">
            <div class="tag-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
              </svg>
            </div>
            <span class="tag-label">Welcoming</span>
          </div>
          <div class="feedback-tag">
            <div class="tag-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
              </svg>
            </div>
            <span class="tag-label">Good setting</span>
          </div>
          <div class="feedback-tag">
            <div class="tag-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <span class="tag-label">Felt safe</span>
          </div>
          <div class="feedback-tag">
            <div class="tag-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
              </svg>
            </div>
            <span class="tag-label">Made an impact</span>
          </div>
          <div class="feedback-tag">
            <div class="tag-icon">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
              </svg>
            </div>
            <span class="tag-label">Met new people</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .social-proof-container {
    background: var(--color-bg-soft);
  }

  /* Stats Section */
  .stats-section {
    padding: 3rem 0;
    background: white;
    border-top: 1px solid rgba(247, 127, 0, 0.2);
    border-bottom: 1px solid rgba(247, 127, 0, 0.2);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .stats-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .stat-item {
    text-align: center;
    padding: 1rem;
  }

  .stat-value {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    font-weight: 800;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-accent) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .stat-label {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Feedback Section */
  .feedback-section {
    padding: 4rem 0;
  }

  .feedback-tags {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 2rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 640px) {
    .feedback-tags {
      grid-template-columns: repeat(2, 1fr);
      max-width: 320px;
    }
  }

  .feedback-tag {
    background: white;
    border-radius: 16px;
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    transition: all 0.3s ease;
  }

  .feedback-tag:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(247, 127, 0, 0.15);
  }

  .feedback-tag:hover .tag-icon {
    transform: scale(1.1);
  }

  .tag-icon {
    width: 2.75rem;
    height: 2.75rem;
    background: linear-gradient(
      135deg,
      var(--color-primary) 0%,
      var(--color-accent) 100%
    );
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease;
  }

  .tag-icon svg {
    width: 1.5rem;
    height: 1.5rem;
    color: white;
  }

  .tag-label {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--color-text-primary);
    text-align: center;
  }

  .tag-count {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-bg-light);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
  }

  /* Animation on scroll */
  @media (prefers-reduced-motion: no-preference) {
    .stat-item,
    .feedback-tag {
      animation: fadeInUp 0.6s ease-out;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>
