---
import { Image } from "astro:assets";
import logoImage from "../assets/logo-header.png";
import { useTranslations } from "../lib/i18n/utils";

const t = useTranslations();
const currentPath = Astro.url.pathname;

// Determine which navigation item is active
const isHome = currentPath === "/";
const isConference = currentPath.includes("/conf-2026");
const isMeetups = currentPath.includes("/meetups");
const isNews = currentPath.startsWith("/news");
const isAbout = currentPath.includes("/about");
---

<header
  class="site-header relative z-50 w-full border-b border-[var(--color-secondary)]"
  style="border-opacity: 0.1;"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <div class="flex items-center">
        <a href="/" class="flex items-center" aria-label="Agentic Hamburg home">
          <Image
            src={logoImage}
            alt="Agentic Hamburg"
            width={400}
            height={97}
            class="h-10 w-auto rounded-md"
            loading="eager"
            decoding="sync"
          />
        </a>
      </div>
      <nav class="flex items-center space-x-6 text-lg font-semibold">
        <a href="/" class:list={["nav-link", { active: isHome }]}>Home</a>
        <a href="/conf-2026" class:list={["nav-link", { active: isConference }]}
          >{t.header.conference}</a
        >
        <a href="/meetups" class:list={["nav-link", { active: isMeetups }]}
          >{t.header.meetups}</a
        >
        <a href="/news" class:list={["nav-link", { active: isNews }]}
          >{t.header.news}</a
        >
        <a href="/about" class:list={["nav-link", { active: isAbout }]}
          >{t.header.about}</a
        >
      </nav>
    </div>
  </div>
</header>

<style>
  .nav-link {
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-link.active {
    color: var(--color-primary-dark);
    font-weight: 700;
  }
</style>
