---
// Horizontal, Hamburg logo from the design system (assets/logos/). Vector only:
// never rasterise, redraw or recolor it. Slategreen art sits on the paper header.
import logo from "../assets/brand/logo-horizontal-slategreen-hamburg.svg";
import { useTranslations } from "../lib/i18n/utils";

const t = useTranslations();
const currentPath = Astro.url.pathname;

// Determine which navigation item is active
const isHome = currentPath === "/";
const isConference = currentPath.includes("/conf-2026");
const isMeetups = currentPath.includes("/meetups");
const isNews = currentPath.startsWith("/news");
const isAbout = currentPath.includes("/about");
---

<header
  class="site-header relative z-50 w-full border-b-2 border-[var(--salmon)]"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <div class="flex items-center">
        <a href="/" class="flex items-center" aria-label="Agentic Hamburg home">
          <img
            src={logo.src}
            alt="Agentic Hamburg"
            width={logo.width}
            height={logo.height}
            class="site-logo"
            loading="eager"
            decoding="sync"
          />
        </a>
      </div>
      <nav class="flex items-center space-x-6 text-lg font-semibold">
        <a href="/" class:list={["nav-link", { active: isHome }]}>Home</a>
        <a href="/conf-2026" class:list={["nav-link", { active: isConference }]}
          >{t.header.conference}</a
        >
        <a href="/meetups" class:list={["nav-link", { active: isMeetups }]}
          >{t.header.meetups}</a
        >
        <a href="/news" class:list={["nav-link", { active: isNews }]}
          >{t.header.news}</a
        >
        <a href="/about" class:list={["nav-link", { active: isAbout }]}
          >{t.header.about}</a
        >
      </nav>
    </div>
  </div>
</header>

<style>
  .site-logo {
    display: block;
    height: 2.25rem;
    width: auto;
  }

  @media (max-width: 767px) {
    .site-header > div > div {
      height: auto;
      flex-direction: column;
      gap: 0.75rem;
      padding-block: 0.75rem;
    }

    nav {
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem 1rem;
      font-size: 1rem;
    }

    nav > .nav-link {
      margin-left: 0;
    }
  }

  .nav-link {
    color: var(--color-text-secondary);
    transition: color 0.2s ease;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-text-primary);
  }

  .nav-link.active {
    color: var(--color-secondary);
    font-weight: 700;
  }
</style>
