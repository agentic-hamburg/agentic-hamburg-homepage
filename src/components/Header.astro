---
import { Image } from "astro:assets";
import headerLogo from "../assets/header.png";
import { useTranslations } from "../lib/i18n/utils";

const t = useTranslations();
const currentPath = Astro.url.pathname;

// Determine which navigation item is active
const isHome = currentPath === "/";
const isConference = currentPath.includes("/conf-2026");
const isMeetups = currentPath.includes("/meetups");
const isNews = currentPath.startsWith("/news");
const isAbout = currentPath.includes("/about");
---

<header class="site-header relative z-50 w-full border-b border-black">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-20 items-center justify-between">
      <div class="flex items-center">
        <a href="/" class="flex items-center" aria-label="Agentic Hamburg home">
          <Image
            src={headerLogo}
            alt="Agentic Hamburg"
            width={320}
            height={64}
            class="h-16 w-auto"
            loading="eager"
            decoding="sync"
          />
        </a>
      </div>
      <nav class="flex items-center space-x-6 text-lg font-semibold">
        <a
          href="/"
          class={`text-gray-700 hover:text-gray-900 ${isHome ? "font-bold" : ""}`}
          >Home</a
        >
        <a
          href="/conf-2026"
          class={`text-gray-700 hover:text-gray-900 ${isConference ? "font-bold" : ""}`}
          >{t.header.conference}</a
        >
        <a
          href="/meetups"
          class={`text-gray-700 hover:text-gray-900 ${isMeetups ? "font-bold" : ""}`}
          >{t.header.meetups}</a
        >
        <a
          href="/news"
          class={`text-gray-700 hover:text-gray-900 ${isNews ? "font-bold" : ""}`}
          >{t.header.news}</a
        >
        <a
          href="/about"
          class={`text-gray-700 hover:text-gray-900 ${isAbout ? "font-bold" : ""}`}
          >{t.header.about}</a
        >
      </nav>
    </div>
  </div>
</header>
