---
import beehive from "../assets/brand/beehive-slategreen.svg";
import { useTranslations } from "../lib/i18n/utils";

const t = useTranslations();
---

<footer
  class="site-footer w-full border-t"
  style="border-color: rgba(36, 64, 67, 0.12);"
>
  <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8">
    <div class="flex flex-col items-center justify-center gap-3">
      <img
        src={beehive.src}
        alt=""
        aria-hidden="true"
        width={beehive.width}
        height={beehive.height}
        class="footer-mark"
        loading="lazy"
      />
      <p
        class="text-center text-sm"
        style="color: var(--color-text-secondary);"
      >
        Built with care in Hamburg &middot;
        <a href="/imprint" class="link">{t.footer.imprint}</a> &middot;
        <a href="/privacy" class="link">Privacy</a> &middot;
        <a href="/tos" class="link">Terms</a> &middot;
        <a
          href="https://luma.com/agentic-hamburg"
          target="_blank"
          rel="noopener noreferrer"
          class="link">Luma · updates</a
        >
      </p>
    </div>
  </div>
</footer>

<style>
  /* Beehive mark, as in the design system's BeeFooter: slategreen on paper at 85% */
  .footer-mark {
    height: 1.75rem;
    width: auto;
    opacity: 0.85;
  }

  .link {
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .link:hover {
    color: var(--color-secondary);
    text-decoration: underline;
  }
</style>
