---
// Community updates must not use the conference waitlist endpoint.
// The public calendar offers calendar subscription options; email opt-in is unverified.
---

<div
  class="border-2 border-[var(--color-primary)] bg-white p-8 shadow-lg sm:p-10"
>
  <h2 class="mb-6 text-3xl font-bold text-[var(--color-text-primary)]">
    Keep Up with the Community
  </h2>
  <p class="mb-4 text-[var(--color-text-secondary)]">
    Find upcoming meetups on our Luma calendar. Use Luma's calendar options to
    add events to your calendar. Register for each event separately on Luma.
  </p>
  <a href="https://luma.com/agentic-hamburg" class="calendar-link"
    >Open Community Calendar →</a
  >
  <p class="mt-4 text-sm text-[var(--color-text-secondary)]">
    Calendar options are provided by Luma. <a href="/privacy" class="underline"
      >Privacy</a
    >
  </p>
</div>

<style>
  .calendar-link {
    display: inline-block;
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: var(--color-secondary);
    color: white;
    font-weight: 700;
    text-decoration: none;
  }

  .calendar-link:hover {
    background: var(--color-secondary-light);
  }
</style>
