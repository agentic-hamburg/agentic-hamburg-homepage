---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Tag from "@/components/blog/Tag.astro";
import Pagination from "@/components/blog/Pagination.astro";
import getUniqueTags from "@/utils/getUniqueTags";
import getPostsByTag from "@/utils/getPostsByTag";
import { slugifyStr } from "@/utils/slugify";

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection(
    "news",
    ({ data }) => import.meta.env.DEV || !data.draft
  );
  const tags = getUniqueTags(posts);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(posts, tag);
    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: 10,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { tagName } = Astro.props;
const { tag } = Astro.params;

const dateFormat = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={`Posts tagged "${tagName}" | Agentic Hamburg`}>
  <Header />

  <main class="mx-auto max-w-4xl px-4 py-12">
    <header class="mb-8">
      <h1 class="display-title mb-4">
        Posts tagged <Tag tag={tag!} tagName={tagName} />
      </h1>
      <p class="text-gray-600">
        {page.total} post{page.total !== 1 ? "s" : ""} found
      </p>
    </header>

    <section class="space-y-8">
      {
        page.data.map(post => (
          <article class="border-b border-gray-200 pb-8 last:border-0">
            <h2 class="mb-2 text-2xl font-bold">
              <a
                href={`/news/${post.id}`}
                class="text-gray-900 hover:text-[#f77f00]"
              >
                {post.data.title}
              </a>
            </h2>
            <div class="mb-3 flex flex-wrap items-center gap-2 text-sm text-gray-600">
              <span>By {post.data.author}</span>
              <span>•</span>
              <time datetime={post.data.pubDatetime.toISOString()}>
                {dateFormat.format(post.data.pubDatetime)}
              </time>
            </div>
            <p class="mb-4 text-gray-600">{post.data.description}</p>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map(t => (
                <Tag tag={slugifyStr(t)} tagName={t} size="sm" />
              ))}
            </div>
          </article>
        ))
      }
    </section>

    {
      page.lastPage > 1 && (
        <div class="mt-12">
          <Pagination page={page} />
        </div>
      )
    }

    <div class="mt-12 flex gap-4">
      <a href="/news/tags" class="text-blue-600 hover:underline"
        >&larr; All tags</a
      >
      <a href="/news" class="text-blue-600 hover:underline">&larr; All posts</a>
    </div>
  </main>

  <Footer />
</Layout>
