---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Agentic Conf 2027 is coming – Agentic Hamburg"
  description="Agentic Conf 2027 is coming. Join our mailing list for the latest news in English and ticket announcements. We'll email you when ticket sales open."
>
  <Header />
  <main class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <p class="mb-4 text-sm font-bold uppercase tracking-widest">
      Agentic Hamburg
    </p>
    <h1 class="display-title">Agentic Conf 2027 is coming.</h1>
    <p class="mt-6 text-xl text-[var(--color-text-secondary)]">
      Details will be announced here.
    </p>

    <section
      aria-labelledby="mailing-list-title"
      class="mt-12 rounded-2xl border border-[var(--color-accent)] bg-[var(--color-bg-soft)] p-6 sm:p-10"
    >
      <h2 id="mailing-list-title" class="text-2xl font-bold sm:text-3xl">
        Be first to hear.
      </h2>
      <p
        class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-text-secondary)]"
      >
        Join our mailing list for the latest news in English and the best ticket
        prices. We'll email you as soon as ticket sales open.
      </p>
      <form
        id="conf-signup"
        action="/api/conf-2027-signup"
        method="post"
        class="mt-6"
      >
        <label for="signup-email" class="block font-bold">Email address</label>
        <div class="mt-2 flex flex-col gap-3 sm:flex-row">
          <input
            id="signup-email"
            name="email"
            type="email"
            autocomplete="email"
            required
            maxlength="254"
            placeholder="you@example.com"
            class="min-h-12 min-w-0 flex-1 rounded-lg border border-[var(--color-secondary)] bg-white px-4 py-3 text-[var(--color-text-primary)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
          />
          <button
            type="submit"
            class="min-h-12 rounded-lg bg-[var(--color-secondary)] px-6 py-3 font-bold text-white hover:bg-[var(--color-secondary-light)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 disabled:opacity-60"
            >Notify me</button
          >
        </div>
        <div hidden aria-hidden="true">
          <label for="signup-website">Leave this empty</label>
          <input
            id="signup-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <label
          class="mt-4 flex min-h-11 cursor-pointer items-start gap-3 text-sm leading-relaxed"
        >
          <input
            name="consent"
            type="checkbox"
            value="yes"
            required
            class="mt-1 h-5 w-5 shrink-0 accent-[var(--color-secondary)]"
          />
          <span
            >I agree to receive Agentic Hamburg community and conference updates
            by email, including ticket announcements. We use Luma to manage the
            mailing list. Unsubscribe at any time.</span
          >
        </label>
        <p
          id="signup-status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          class="mt-4 font-semibold"
        >
        </p>
        <noscript
          ><p class="mt-4 text-sm">
            Enable JavaScript to use this form, or <a
              href="https://luma.com/agentic-hamburg"
              class="underline">follow us on Luma</a
            >.
          </p></noscript
        >
      </form>
      <p class="mt-3 text-sm">
        <a href="/privacy" class="underline underline-offset-4">Privacy</a>
      </p>
    </section>

    <p class="mt-10">
      <a
        href="/conf-2026"
        class="inline-flex min-h-11 items-center underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        Explore Agentic Conf 2026
      </a>
    </p>
  </main>
  <Footer />
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>("#conf-signup");
  const status = document.querySelector<HTMLParagraphElement>("#signup-status");
  const button = form?.querySelector<HTMLButtonElement>(
    'button[type="submit"]'
  );
  if (form && status && button) {
    form.addEventListener("submit", async event => {
      event.preventDefault();
      if (button.disabled) return;
      button.disabled = true;
      button.textContent = "Signing up…";
      status.textContent = "";
      try {
        const values = new FormData(form);
        const body = new URLSearchParams();
        for (const [key, value] of values)
          if (typeof value === "string") body.append(key, value);
        const response = await fetch(form.action, {
          method: "POST",
          body,
          signal: AbortSignal.timeout(12000),
        });
        const result = await response.json();
        status.textContent =
          result.message || "Something went wrong. Please try again.";
        if (response.ok) form.reset();
      } catch {
        status.textContent =
          "We couldn't reach the sign-up service. Please try again.";
      } finally {
        button.disabled = false;
        button.textContent = "Notify me";
      }
    });
  }
</script>
