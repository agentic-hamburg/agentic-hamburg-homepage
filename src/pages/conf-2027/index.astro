---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
---

<Layout
  title="Agentic Conf 2027 is coming – Agentic Hamburg"
  description="Agentic Conf 2027 is coming. Join our mailing list for the latest news in English and ticket announcements. We'll email you when ticket sales open."
>
  <Header />
  <main class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <p class="mb-4 text-sm font-bold uppercase tracking-widest">
      Agentic Hamburg
    </p>
    <h1 class="display-title">Agentic Conf 2027 is coming.</h1>
    <p class="mt-6 text-xl text-[var(--color-text-secondary)]">
      Details will be announced here.
    </p>

    <section
      aria-labelledby="mailing-list-title"
      class="mt-12 rounded-2xl border border-[var(--color-accent)] bg-[var(--color-bg-soft)] p-6 sm:p-10"
    >
      <h2 id="mailing-list-title" class="text-2xl font-bold sm:text-3xl">
        Be first to hear.
      </h2>
      <p
        class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--color-text-secondary)]"
      >
        Join our mailing list for the latest news in English and the best ticket
        prices. We'll email you as soon as ticket sales open.
      </p>
      <a
        href="https://luma.com/agentic-hamburg"
        class="mt-6 inline-flex min-h-11 items-center justify-center rounded-lg bg-[var(--color-secondary)] px-6 py-3 text-center font-bold text-white transition-colors hover:bg-[var(--color-secondary-light)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--color-secondary)]"
      >
        Join the mailing list on Luma →
      </a>
      <p
        class="mt-4 text-sm leading-relaxed text-[var(--color-text-secondary)]"
      >
        Click “Follow” on our Luma page and sign in or create an account to
        join. You'll receive Agentic Hamburg community and conference updates.
        You can unsubscribe at any time.
      </p>
      <p class="mt-3 text-sm">
        <a href="/privacy" class="underline underline-offset-4">Privacy</a>
      </p>
    </section>

    <p class="mt-10">
      <a
        href="/conf-2026"
        class="inline-flex min-h-11 items-center underline underline-offset-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
      >
        Explore Agentic Conf 2026
      </a>
    </p>
  </main>
  <Footer />
</Layout>
