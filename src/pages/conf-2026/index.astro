---

<Layout
  title="Agentic Conf Hamburg 2026 - March 22"
  description="A full-day conference for developers building with AI. March 22, 2026 at SAE Institute Hamburg."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="conf-hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-date">March 22, 2026</span>
          <span class="badge-divider"></span>
          <span class="badge-location">Hamburg, Germany</span>
        </div>

        <h1 class="conf-title">Agentic Conf<br />Hamburg 2026</h1>

        <p class="conf-tagline">
          Software engineering is being rewritten. This is where we figure out
          what comes next — together.<br />
          Talks, demos, workshops, and good vibes.
        </p>

        <div class="hero-ctas">
          <a href="/conf-2026/schedule/" class="cta-primary">
            View Schedule
            <svg
              class="cta-arrow"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a href="#newsletter" class="cta-tertiary">
            Get Updates
          </a>
        </div>
        <div class="hero-meta">
          <span class="sold-out-tag">Sold Out</span>
          <div class="hero-venue">
            <svg class="venue-icon" fill="currentColor" viewBox="0 0 20 20">
              <path
                fill-rule="evenodd"
                d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Medienbunker (SAE Institute Hamburg)</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Sponsor Logo Strip -->
    <div class="logo-strip">
      <span class="logo-strip-label">Supported by</span>
      <div class="logo-strip-logos">
        <img src={sponsorAfcSvg.src} alt="AFC" class="logo-strip-img" />
        <img src={sponsorVorwerkSvg.src} alt="Vorwerk" class="logo-strip-img" />
        <Image
          src={sponsorHackersWizardsImg}
          alt="Hackers and Wizards"
          class="logo-strip-img"
          width={120}
        />
        <img
          src={sponsorTegtmeierSvg.src}
          alt="Tegtmeier"
          class="logo-strip-img"
        />
        <img
          src={sponsorAdessoSvg.src}
          alt="Adesso Insurance Solutions"
          class="logo-strip-img"
        />
        <img
          src={sponsorDlSchoolSvg.src}
          alt="DL School"
          class="logo-strip-img"
        />
        <img src={sponsorInnoqSvg.src} alt="INNOQ" class="logo-strip-img" />
        <Image
          src={sponsorFobizzImg}
          alt="Fobizz"
          class="logo-strip-img"
          width={80}
        />
      </div>
    </div>

    <!-- Stats Bar -->
    <section class="stats-bar">
      <div class="stats-container">
        <div class="stat-item">
          <span class="stat-value">{communityStats.memberCount}</span>
          <span class="stat-label">Community Members</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">{communityStats.meetupCount}</span>
          <span class="stat-label">Sold-Out Meetups</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">4.8<span class="stat-star">★</span></span>
          <span class="stat-label">Avg Rating</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">100%</span>
          <span class="stat-label">Events Sold Out</span>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="conf-section conf-about">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">Our Story</p>
        <h2 class="section-title">From Meetup to Conference</h2>
        <div class="prose prose-lg">
          <p>
            What started as a small gathering of developers curious about AI
            coding tools has grown into Hamburg's largest agentic coding
            community with over 1,000 members.
          </p>
          <p>
            After four successful meetups with 100+ developers at each event,
            we're taking the next step: a full-day conference dedicated to the
            practitioners who are actually building with AI, not just talking
            about it.
          </p>
          <p>
            Expect real workflows, live demos, and honest discussions about
            what's working in agentic development. No vendor pitches, no
            theoretical frameworks — just builders sharing their craft.
          </p>
          <p class="about-vision">
            Our goal is simple: create a space with good vibes where people
            learn from each other and leave energized with fresh ideas to try on
            Monday morning.
          </p>
        </div>
      </div>
    </section>

    <!-- Speakers Section -->
    <section class="conf-section conf-speakers" id="speakers">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">The Lineup</p>
        <h2 class="section-title">Speakers</h2>
        <div class="speakers-grid">
          {
            speakerCards.map(speaker => (
              <a
                href={`/conf-2026/sessions/${speaker.slug}/`}
                class="speaker-card-link"
              >
                <article class="speaker-card">
                  <Image
                    src={speaker.image}
                    alt={speaker.name}
                    width={48}
                    height={48}
                    class="speaker-photo"
                  />
                  <div class="speaker-info">
                    <h3 class="speaker-name">{speaker.name}</h3>
                    <p class="speaker-talk">{speaker.title}</p>
                    <span
                      class:list={[
                        "speaker-format",
                        `format-${speaker.format.toLowerCase().replace(" ", "-")}`,
                      ]}
                    >
                      {speaker.format}
                    </span>
                  </div>
                </article>
              </a>
            ))
          }
        </div>
        <p class="speakers-more">
          <a href="/conf-2026/schedule/" class="schedule-link">View full schedule →</a>
        </p>
      </div>
    </section>

    <!-- Schedule Section -->
    <section class="conf-section conf-schedule">
      <div class="mx-auto max-w-4xl px-4 text-center">
        <p class="section-label">The Day</p>
        <h2 class="section-title">Schedule</h2>
        <div class="schedule-simple">
          <span class="schedule-time-large">09:00 – 18:00</span>
        </div>
        <p class="schedule-highlights">
          4 tracks · 20+ talks · Workshops · Lightning Talks · Open Spaces
        </p>
        <a href="/conf-2026/schedule/" class="schedule-cta">
          View Full Schedule →
        </a>
      </div>
    </section>

    <!-- Venue Section -->
    <section class="conf-section conf-venue-section">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">The Venue</p>
        <h2 class="section-title">SAE Institute Hamburg</h2>
        <div class="venue-image">
          <Image
            src={venueImg}
            alt="SAE Institute Hamburg - Medienbunker"
            width={900}
            height={506}
            class="venue-illustration"
          />
        </div>
        <div class="venue-details">
          <div class="venue-info">
            <div class="venue-address">
              <svg class="info-icon" fill="currentColor" viewBox="0 0 20 20">
                <path
                  fill-rule="evenodd"
                  d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z"
                  clip-rule="evenodd"></path>
              </svg>
              <a
                href="https://maps.google.com/?q=Feldstr.+66,+20359+Hamburg"
                target="_blank"
                rel="noopener noreferrer"
                class="venue-address-link"
              >
                <strong>Feldstr. 66</strong> (Medienbunker)<br />
                20359 Hamburg
              </a>
            </div>
            <div class="venue-transport">
              <svg class="info-icon" fill="currentColor" viewBox="0 0 20 20">
                <path
                  d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"
                ></path>
                <path
                  d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z"
                ></path>
              </svg>
              <div>
                <strong>U-Bahn Feldstraße</strong><br />
                1 min walk
              </div>
            </div>
          </div>
          <div class="venue-spaces">
            <h3>Available Spaces</h3>
            <ul>
              <li><strong>Main Room:</strong> Main track</li>
              <li><strong>Altona Room:</strong> Breakout room</li>
              <li><strong>St. Pauli Room:</strong> Breakout room</li>
              <li><strong>The Space:</strong> Open space</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="conf-section conf-testimonials">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">From Our Meetups</p>
        <h2 class="section-title">What Attendees Say</h2>
        <div class="testimonial-marquee">
          <div class="marquee-track">
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">
                "Engaging and informative sessions"
              </p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Welcoming community atmosphere"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Good vibes, great people"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Made a real impact on my work"</p>
