---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { communityStats } from "../config/community";
import stefanImg from "../assets/stefan.jpeg";
import sebastianKorfmannImg from "../assets/sebastian-korfmann.jpg";
import sebastianReimannImg from "../assets/sebastian-reimann.jpeg";
import venueImg from "../assets/venue-illustration.jpg";

const ticketUrl = "https://lu.ma/45lfeyeh";

const organizers = [
  {
    name: "Stefan Munz",
    role: "The Liquid Engineer",
    image: stefanImg,
    linkedin: "https://www.linkedin.com/in/stefanmunz/",
  },
  {
    name: "Sebastian Korfmann",
    role: "Chief Tinkering Officer",
    image: sebastianKorfmannImg,
    linkedin: "https://www.linkedin.com/in/skorfmann/",
  },
  {
    name: "Sebastian Reimann",
    role: "AI/ML Team Herder",
    image: sebastianReimannImg,
    linkedin: "https://www.linkedin.com/in/sebastian-reimann-b1a2042a4/",
  },
];

const faqs = [
  {
    question: "When and where is the conference?",
    answer: "Agentic Conf Hamburg 2026 takes place on March 22, 2026 at SAE Institute Hamburg, Feldstr. 66, 20359 Hamburg.",
  },
  {
    question: "What time does the conference run?",
    answer: "The conference runs from 09:00 to 18:00, with registration opening at 08:30.",
  },
  {
    question: "How many attendees are expected?",
    answer: "We're expecting 200–300 practitioners. A focused, high-quality gathering of people actually building with AI.",
  },
  {
    question: "Will there be food and drinks?",
    answer: "Yes, we'll provide coffee and refreshments throughout the day. More details coming soon.",
  },
  {
    question: "How can I become a speaker?",
    answer: "We're currently finalizing our speaker lineup. Reach out to us at hello@agentic.hamburg if you're interested.",
  },
  {
    question: "Is there parking available?",
    answer: "Street parking is available in the area. The venue is also easily accessible by public transport (U-Bahn Feldstraße).",
  },
  {
    question: "What is the refund policy?",
    answer: "Tickets are non-refundable, but they are transferable. If you can't attend, you can transfer your ticket to someone else — just email us at hello@agentic.hamburg. Full refunds are only offered if we cancel or significantly change the event.",
  },
  {
    question: "How do I get an invoice?",
    answer: "Email us at hello@agentic.hamburg and we'll provide you with a proper invoice for your business ticket.",
  },
];
---

<Layout
  title="Agentic Conf Hamburg 2026 - March 22"
  description="A full-day conference for developers building with AI. March 22, 2026 at SAE Institute Hamburg."
>
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="conf-hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-date">March 22, 2026</span>
          <span class="badge-divider"></span>
          <span class="badge-location">Hamburg, Germany</span>
        </div>

        <h1 class="conf-title">Agentic Conf<br />Hamburg 2026</h1>

        <p class="conf-tagline">
          Software engineering is being rewritten. This is where we figure out what comes next — together.<br />
          Talks, demos, workshops, and good vibes.
        </p>

        <div class="hero-ctas">
          <a href={ticketUrl} target="_blank" rel="noopener noreferrer" class="cta-primary">
            Get Tickets
            <svg class="cta-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>

        <div class="hero-venue">
          <svg class="venue-icon" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
          </svg>
          <span>Medienbunker (SAE Institute Hamburg)</span>
        </div>
      </div>
    </section>

    <!-- Stats Bar -->
    <section class="stats-bar">
      <div class="stats-container">
        <div class="stat-item">
          <span class="stat-value">{communityStats.memberCount}</span>
          <span class="stat-label">Community Members</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">{communityStats.meetupCount}</span>
          <span class="stat-label">Sold-Out Meetups</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">4.8<span class="stat-star">★</span></span>
          <span class="stat-label">Avg Rating</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat-item">
          <span class="stat-value">100%</span>
          <span class="stat-label">Events Sold Out</span>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section class="conf-section conf-about">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">Our Story</p>
        <h2 class="section-title">From Meetup to Conference</h2>
        <div class="prose prose-lg">
          <p>
            What started as a small gathering of developers curious about AI coding tools has grown into Hamburg's largest agentic coding community with over 1,000 members.
          </p>
          <p>
            After four successful meetups with 100+ developers at each event, we're taking the next step: a full-day conference dedicated to the practitioners who are actually building with AI, not just talking about it.
          </p>
          <p>
            Expect real workflows, live demos, and honest discussions about what's working in agentic development. No vendor pitches, no theoretical frameworks—just builders sharing their craft.
          </p>
        </div>
      </div>
    </section>

    <!-- Venue Section -->
    <section class="conf-section conf-venue-section">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">The Venue</p>
        <h2 class="section-title">SAE Institute Hamburg</h2>
        <div class="venue-image">
          <Image
            src={venueImg}
            alt="SAE Institute Hamburg - Medienbunker"
            width={900}
            height={506}
            class="venue-illustration"
          />
        </div>
        <div class="venue-details">
          <div class="venue-info">
            <div class="venue-address">
              <svg class="info-icon" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
              </svg>
              <a href="https://maps.google.com/?q=Feldstr.+66,+20359+Hamburg" target="_blank" rel="noopener noreferrer" class="venue-address-link">
                <strong>Feldstr. 66</strong> (Medienbunker)<br />
                20359 Hamburg
              </a>
            </div>
            <div class="venue-transport">
              <svg class="info-icon" fill="currentColor" viewBox="0 0 20 20">
                <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z" />
                <path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 00-1 1v6.05A2.5 2.5 0 0115.95 16H17a1 1 0 001-1v-5a1 1 0 00-.293-.707l-2-2A1 1 0 0015 7h-1z" />
              </svg>
              <div>
                <strong>U-Bahn Feldstraße</strong><br />
                1 min walk
              </div>
            </div>
          </div>
          <div class="venue-spaces">
            <h3>Available Spaces</h3>
            <ul>
              <li><strong>Main Room:</strong> Main track</li>
              <li><strong>Altona Room:</strong> Breakout room</li>
              <li><strong>St. Pauli Room:</strong> Breakout room</li>
              <li><strong>The Space:</strong> Open space</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Schedule Section -->
    <section class="conf-section conf-schedule">
      <div class="mx-auto max-w-4xl px-4 text-center">
        <p class="section-label">The Day</p>
        <h2 class="section-title">Schedule</h2>
        <div class="schedule-simple">
          <span class="schedule-time-large">09:00 – 18:00</span>
        </div>
        <p class="schedule-note">Detailed agenda coming soon.</p>
      </div>
    </section>

    <!-- What to Expect Section -->
    <section class="conf-section conf-expect">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">What to Expect</p>
        <h2 class="section-title">Built by the Community, for the Community</h2>
        <div class="expect-content">
          <p class="expect-intro">
            How you code. How your team works. How your company ships. It's all being rewritten — and no playbook exists yet. This conference is where we write it together.
          </p>
          <p class="expect-description">
            This conference is focused on all things agentic: software engineering, ops, cloud, UX/design, product development—the entire stack of building and operating digital products. Expect fast-paced talks, lightning sessions, live demos, hands-on workshops, hack sessions, hardware experiments, open mics—and whatever else you bring to the table.
          </p>
          <p class="expect-vision">
            Our goal is simple: create a space with good vibes where people learn from each other and leave energized with fresh ideas to try on Monday morning.
          </p>
        </div>
      </div>
    </section>

    <!-- Speakers Section -->
    <section class="conf-section conf-speakers">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">The Speakers</p>
        <h2 class="section-title">Lineup Coming Soon</h2>
        <p class="section-description">
          We're currently finalizing an exciting lineup of practitioners who are building with AI every day. Stay tuned for announcements.
        </p>
        <p class="section-description">
          Interested in speaking? Reach out at <a href="mailto:hello@agentic.hamburg">hello@agentic.hamburg</a>
        </p>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class="conf-section conf-testimonials">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">From Our Meetups</p>
        <h2 class="section-title">What Attendees Say</h2>
        <div class="testimonial-marquee">
          <div class="marquee-track">
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Engaging and informative sessions"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Welcoming community atmosphere"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Good vibes, great people"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Made a real impact on my work"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Met amazing new people"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Perfect venue and setting"</p>
            </div>
            <!-- Duplicate for seamless loop -->
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Engaging and informative sessions"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Welcoming community atmosphere"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Good vibes, great people"</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Tickets Section -->
    <section class="conf-section conf-tickets">
      <div class="mx-auto max-w-4xl px-4 text-center">
        <p class="section-label">Join Us</p>
        <h2 class="section-title">Get Your Ticket</h2>
        <p class="section-description">
          Secure your spot at Hamburg's first agentic coding conference.
        </p>
        <a href={ticketUrl} target="_blank" rel="noopener noreferrer" class="cta-primary cta-large">
          Get Tickets on Luma
          <svg class="cta-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </section>

    <!-- Organizers Section -->
    <section class="conf-section conf-organizers">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">The Team</p>
        <h2 class="section-title">Organizers</h2>
        <div class="organizers-grid">
          {organizers.map(organizer => (
            <article class="organizer-card">
              <a href={organizer.linkedin} target="_blank" rel="noopener noreferrer" class="organizer-link">
                <div class="organizer-image-wrapper">
                  <Image
                    src={organizer.image}
                    alt={organizer.name}
                    width={200}
                    height={200}
                    loading="lazy"
                    class="organizer-image"
                  />
                </div>
                <h4 class="organizer-name">{organizer.name}</h4>
                <p class="organizer-role">{organizer.role}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="conf-section conf-faq">
      <div class="mx-auto max-w-4xl px-4">
        <p class="section-label">Questions?</p>
        <h2 class="section-title">FAQ</h2>
        <div class="faq-list">
          {faqs.map(faq => (
            <details class="faq-item">
              <summary class="faq-question">{faq.question}</summary>
              <p class="faq-answer">{faq.answer}</p>
            </details>
          ))}
        </div>
        <p class="faq-contact">
          Still have questions? Email us at <a href="mailto:hello@agentic.hamburg">hello@agentic.hamburg</a>
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Stats Bar */
  .stats-bar {
    background: white;
    border-top: 1px solid rgba(247, 127, 0, 0.2);
    border-bottom: 1px solid rgba(247, 127, 0, 0.2);
    padding: 2rem 1rem;
  }

  .stats-container {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    text-align: center;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
  }

  .stat-star {
    background: none;
    -webkit-text-fill-color: var(--color-accent);
  }

  .stat-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent, rgba(247, 127, 0, 0.3), transparent);
  }

  @media (max-width: 600px) {
    .stat-divider { display: none; }
    .stats-container { gap: 1.5rem; }
  }

  /* Testimonials Section */
  .conf-testimonials {
    overflow: hidden;
  }

  .testimonial-marquee {
    margin-top: 2rem;
    mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    animation: marquee 30s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .testimonial-card {
    flex-shrink: 0;
    background: white;
    padding: 1.5rem 2rem;
    border-radius: 16px;
    box-shadow: 0 2px 15px rgba(0, 0, 0, 0.04);
    border: 1px solid rgba(0, 0, 0, 0.04);
  }

  .testimonial-rating {
    color: var(--color-accent);
    font-size: 0.9rem;
    letter-spacing: 2px;
    margin-bottom: 0.5rem;
  }

  .testimonial-text {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  /* Hero Section */
  .conf-hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      var(--color-bg-soft) 0%,
      var(--color-bg-cream) 40%,
      #fff5eb 100%
    );
  }

  .hero-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='600' height='600' viewBox='0 0 600 600' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23f77f00' fill-opacity='0.04'%3E%3Ccircle cx='100' cy='150' r='120'/%3E%3Ccircle cx='550' cy='500' r='150'/%3E%3Crect x='350' y='80' width='180' height='180' rx='30' transform='rotate(15 440 170)'/%3E%3Cpolygon points='80,420 200,580 -40,580'/%3E%3Crect x='250' y='320' width='120' height='120' rx='15' transform='rotate(-10 310 380)'/%3E%3Ccircle cx='500' cy='200' r='80'/%3E%3C/g%3E%3C/svg%3E");
    background-size: cover;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    padding: 2rem;
    max-width: 900px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    padding: 0.75rem 1.5rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 2rem;
    box-shadow: 0 4px 20px rgba(247, 127, 0, 0.35);
  }

  .badge-divider {
    width: 4px;
    height: 4px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
  }

  .conf-title {
    font-size: clamp(3rem, 10vw, 6rem);
    font-weight: 900;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-text-primary);
    margin-bottom: 1.5rem;
  }

  .hero-venue {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    font-weight: 500;
  }

  .venue-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-primary);
  }

  .conf-tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .cta-arrow {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.3s ease;
  }

  .cta-primary:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* Section Styles */
  .conf-section {
    padding: 5rem 0;
  }

  .conf-section:nth-child(even) {
    background: var(--color-bg-soft);
  }

  .section-label {
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: var(--color-text-primary);
    text-align: center;
    margin-bottom: 2rem;
  }

  .section-description {
    font-size: 1.125rem;
    color: var(--color-text-secondary);
    text-align: center;
    max-width: 600px;
    margin: 0 auto 1.5rem;
  }

  .section-description a {
    color: var(--color-primary);
    font-weight: 600;
  }

  /* About Section */
  .conf-about .prose {
    max-width: 700px;
    margin: 0 auto;
  }

  .conf-about .prose p {
    font-size: 1.125rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
    text-align: center;
  }

  /* Venue Section */
  .venue-image {
    margin-bottom: 2rem;
    position: relative;
  }

  .venue-illustration {
    width: 100%;
    max-width: 1000px;
    height: auto;
    margin: 0 auto;
    display: block;
    mask-image: radial-gradient(
      ellipse 90% 80% at 50% 50%,
      black 40%,
      transparent 70%
    );
    -webkit-mask-image: radial-gradient(
      ellipse 90% 80% at 50% 50%,
      black 40%,
      transparent 70%
    );
  }

  .venue-details {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .venue-details {
      grid-template-columns: 1fr 1fr;
    }
  }

  .venue-info {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .venue-address,
  .venue-transport {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    font-size: 1.125rem;
    color: var(--color-text-secondary);
  }

  .info-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--color-primary);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .venue-spaces h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .venue-spaces ul {
    list-style: none;
    padding: 0;
  }

  .venue-spaces li {
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    color: var(--color-text-secondary);
  }

  .venue-spaces li:last-child {
    border-bottom: none;
  }

  .venue-address-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .venue-address-link:hover {
    color: var(--color-primary);
  }

  /* Schedule Section */
  .schedule-simple {
