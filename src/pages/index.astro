---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { communityStats } from "../config/community";
---

<Layout title="Agentic Hamburg - Community for AI Agent Builders">
  <Header />

  <!-- Conference Banner -->
  <a href="/conf-2026" class="conf-banner">
    <div class="banner-content">
      <span class="banner-badge">March 22, 2026</span>
      <span class="banner-text"
        >Agentic Conf Hamburg — Sold Out</span
      >
      <svg
        class="banner-arrow"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M5 12h14M12 5l7 7-7 7"></path>
      </svg>
    </div>
  </a>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
        <div class="hero-orb hero-orb-3"></div>
      </div>

      <div class="hero-content">
        <h1 class="hero-title">
          <span class="title-line">Agentic</span>
          <span class="title-line title-accent">Hamburg</span>
        </h1>

        <p class="hero-tagline">
          Software engineering is being rewritten — how you code, how your team
          works, how your company ships. No playbook exists yet. We're writing
          it together.
        </p>

        <div class="hero-stats">
          <div class="hero-stat">
            <span class="stat-number">{communityStats.memberCount}</span>
            <span class="stat-text">members</span>
          </div>
          <div class="stat-separator"></div>
          <div class="hero-stat">
            <span class="stat-number">{communityStats.meetupCount}</span>
            <span class="stat-text">sold-out events</span>
          </div>
          <div class="stat-separator"></div>
          <div class="hero-stat">
            <span class="stat-number">4.8<span class="stat-star">★</span></span>
            <span class="stat-text">avg rating</span>
          </div>
        </div>
      </div>

      <div class="scroll-indicator">
        <span>Explore</span>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </section>

    <!-- Activities Section -->
    <section class="activities-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-label">What's Happening</span>
          <h2 class="section-title">Join the Movement</h2>
        </div>

        <div class="activities-grid">
          <!-- Conference Card -->
          <article class="activity-card card-conference">
            <div class="card-glow"></div>
            <div class="card-content">
              <div class="card-badge badge-sold-out">
                Sold Out
              </div>

              <div class="card-date">
                <svg
                  class="date-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <rect x="3" y="4" width="18" height="18" rx="2"></rect>
                  <path d="M16 2v4M8 2v4M3 10h18"></path>
                </svg>
                March 22, 2026
              </div>

              <h3 class="card-title">
                Agentic Conf<br />Hamburg 2026
              </h3>

              <p class="card-description">
                A full-day conference with talks, live demos, workshops, and
                networking. The biggest agentic AI event in Northern Germany.
              </p>

              <div class="card-venue">
                <svg
                  class="venue-icon"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
                <span>Medienbunker · SAE Institute Hamburg</span>
              </div>

              <div class="card-actions">
                <a href="/conf-2026" class="btn-primary">
                  <span>View Program</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>

          <!-- Meetups Card -->
          <article class="activity-card card-meetups">
            <div class="card-content">
              <div class="card-badge badge-muted">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="badge-icon"
                >
                  <path
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
                Regular Events
              </div>

              <h3 class="card-title card-title-small">
                Agentic Coding<br />Meetup
              </h3>

              <p class="card-description">
                Regular meetups for talks, demos, and networking with Hamburg's
                agentic coding community.
              </p>

              <div class="card-metrics">
                <div class="metric">
                  <span class="metric-value">{communityStats.meetupCount}</span>
                  <span class="metric-label">events</span>
                </div>
                <div class="metric">
                  <span class="metric-value">400+</span>
                  <span class="metric-label">attendees</span>
                </div>
                <div class="metric">
                  <span class="metric-value">78</span>
                  <span class="metric-label">reviews</span>
                </div>
              </div>

              <div class="card-actions">
                <a href="/meetups" class="btn-secondary">
                  <span>View Meetups</span>
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7"></path>
                  </svg>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Social Proof Section -->
    <section class="proof-section">
      <div class="section-container">
        <div class="proof-header">
          <span class="section-label">Community Feedback</span>
          <h2 class="section-title">What People Say</h2>
        </div>

        <div class="testimonial-marquee">
          <div class="marquee-track">
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">
                "Engaging and informative sessions"
              </p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Welcoming community atmosphere"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Good vibes, great people"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Made a real impact on my work"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Met amazing new people"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Perfect venue and setting"</p>
            </div>
            <!-- Duplicate for seamless loop -->
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">
                "Engaging and informative sessions"
              </p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Welcoming community atmosphere"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Good vibes, great people"</p>
            </div>
          </div>
        </div>

        <div class="proof-summary">
          <div class="summary-stat">
            <span class="summary-value">4.8</span>
            <span class="summary-label">Average Rating</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-stat">
            <span class="summary-value">78</span>
            <span class="summary-label">Reviews</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-stat">
            <span class="summary-value">100%</span>
            <span class="summary-label">Sold-Out Events</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="cta-section">
      <div class="cta-bg">
        <div class="cta-glow"></div>
      </div>
      <div class="section-container">
        <div class="cta-content">
          <h2 class="cta-title">Ready to Build?</h2>
          <p class="cta-text">
            Join Hamburg's most active AI agent community. Subscribe for
            updates on waitlist, recordings, and future events.
          </p>
          <div class="cta-actions">
            <a href="/conf-2026/#newsletter" class="btn-cta">
              <span>Subscribe for Updates</span>
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path d="M5 12h14M12 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== CONFERENCE BANNER ===== */
  .conf-banner {
    display: block;
    position: relative;
    z-index: 40;
    background: var(--color-secondary);
    color: white;
    text-decoration: none;
    padding: 0.75rem 1rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .conf-banner:hover {
    background: var(--color-secondary-light);
  }

  .banner-content {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .banner-badge {
    background: rgba(232, 136, 127, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .banner-text {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .banner-arrow {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .conf-banner:hover .banner-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 500px) {
    .banner-badge {
      display: none;
    }
  }

  /* ===== HERO SECTION ===== */
  .hero {
    position: relative;
    min-height: min(80vh, 700px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 3rem 2rem 4rem;
    background: var(--color-primary);
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
  }

  .hero-orb-1 {
    width: 700px;
    height: 700px;
    background: rgba(214, 112, 106, 0.5);
    top: -300px;
    right: -200px;
  }

  .hero-orb-2 {
    width: 500px;
    height: 500px;
    background: rgba(245, 199, 194, 0.4);
    bottom: -200px;
    left: -150px;
  }

  .hero-orb-3 {
    width: 300px;
    height: 300px;
    background: rgba(44, 62, 58, 0.15);
    top: 40%;
    left: 60%;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 900px;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(4rem, 14vw, 8rem);
    font-weight: 400;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .title-line {
    display: block;
    color: var(--color-secondary);
  }

  .title-accent {
    color: var(--color-secondary);
    opacity: 0.5;
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    line-height: 1.7;
    color: var(--color-secondary);
    max-width: 640px;
    margin: 0 auto 3rem;
    font-weight: 700;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 2.25rem;
    font-weight: 400;
    color: var(--color-secondary);
    line-height: 1;
  }

  .stat-star {
    color: var(--color-secondary);
    margin-left: 2px;
  }

  .stat-text {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-secondary-light);
  }

  .stat-separator {
    width: 1px;
    height: 40px;
    background: linear-gradient(
      180deg,
      transparent,
      rgba(44, 62, 58, 0.25),
      transparent
    );
  }

  @media (max-width: 600px) {
    .stat-separator {
      display: none;
    }
    .hero-stats {
      gap: 1.5rem;
    }
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.5;
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-indicator svg {
    width: 20px;
    height: 20px;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(8px);
    }
  }

  /* ===== SECTION STYLES ===== */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-primary-dark);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 400;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  /* ===== ACTIVITIES SECTION ===== */
  .activities-section {
    padding: 6rem 0;
    background: white;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .activities-grid {
      grid-template-columns: 1fr;
    }
  }

  .activity-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .activity-card:hover {
    transform: translateY(-8px);
  }

  .card-conference {
    background: linear-gradient(
      145deg,
      var(--color-bg-soft) 0%,
      var(--color-bg-light) 100%
    );
    border: 2px solid var(--color-primary);
    box-shadow: 0 4px 30px rgba(232, 136, 127, 0.12);
  }

  .card-conference:hover {
    box-shadow: 0 20px 60px rgba(232, 136, 127, 0.25);
  }

  .card-conference .card-glow {
    position: absolute;
    top: -50%;
    right: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle,
      rgba(232, 136, 127, 0.1) 0%,
      transparent 70%
    );
    pointer-events: none;
  }

  .card-meetups {
    background: var(--color-bg-soft);
    border: 2px solid rgba(44, 62, 58, 0.08);
  }

  .card-meetups:hover {
    border-color: rgba(232, 136, 127, 0.3);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
  }

  .card-content {
    position: relative;
    padding: 2.5rem;
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-dark);
    background: rgba(232, 136, 127, 0.12);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    margin-bottom: 1.25rem;
  }

  .badge-sold-out {
    background: rgba(44, 62, 58, 0.15);
    color: var(--color-text-secondary);
  }

  .badge-live {
    width: 8px;
    height: 8px;
    background: var(--color-primary-dark);
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.2);
    }
  }

  .badge-muted {
    background: rgba(44, 62, 58, 0.06);
    color: var(--color-text-secondary);
  }

  .badge-icon {
    width: 14px;
    height: 14px;
  }

  .card-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .date-icon {
    width: 18px;
    height: 18px;
    color: var(--color-primary-dark);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .card-title-small {
    font-size: clamp(1.5rem, 3vw, 1.75rem);
  }

  .card-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  .card-venue {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 1.75rem;
  }

  .venue-icon {
    width: 18px;
    height: 18px;
    color: var(--color-primary-dark);
    flex-shrink: 0;
  }

  .card-metrics {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(44, 62, 58, 0.08);
    border-bottom: 1px solid rgba(44, 62, 58, 0.08);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-text-primary);
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ===== BUTTONS ===== */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-secondary);
    color: white;
    padding: 1rem 1.75rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 4px 15px rgba(44, 62, 58, 0.25);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(44, 62, 58, 0.35);
    background: var(--color-secondary-light);
  }

  .btn-primary svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: white;
    color: var(--color-secondary);
    padding: 1rem 1.75rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid var(--color-secondary);
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(44, 62, 58, 0.04);
    transform: translateY(-2px);
  }

  .btn-secondary svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .btn-secondary:hover svg {
    transform: translateX(4px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .btn-ghost:hover {
    color: var(--color-primary-dark);
  }

  /* ===== PROOF SECTION ===== */
  .proof-section {
    padding: 6rem 0;
    background: linear-gradient(180deg, var(--color-bg-cream) 0%, white 100%);
    overflow: hidden;
  }

  .proof-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .testimonial-marquee {
    margin-bottom: 3rem;
    mask-image: linear-gradient(
      90deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      90deg,
      transparent,
      black 10%,
      black 90%,
      transparent
    );
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    animation: marquee 30s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .testimonial-card {
    flex-shrink: 0;
    background: white;
    padding: 1.5rem 2rem;
    border-radius: 16px;
