---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
// import Newsletter from "../components/Newsletter.astro"; // Temporarily disabled
import EventCards from "../components/EventCards.astro";
import SocialProof from "../components/SocialProof.astro";
import PastEvents from "../components/PastEvents.astro";
import { useTranslations } from "../lib/i18n/utils";

const t = useTranslations();
---

<Layout title="Agentic Hamburg - The Coding Meetup for Hamburg">
  <Header />

  <main>
    <!-- Hero Section -->
    <section class="hero-section px-4 sm:px-6 lg:px-8">
      <Hero
        title={t.hero.title}
        description={t.hero.subtitle}
        buttonText={t.hero.cta}
      />
    </section>

    <!-- Upcoming Events Section -->
    <section class="events-section">
      <EventCards />
    </section>

    <!-- Social Proof Section -->
    <section class="social-proof-section">
      <SocialProof />
    </section>

    <!-- Past Events Section -->
    <section class="past-events-section">
      <PastEvents />
    </section>

    <!-- Newsletter Section - Temporarily disabled
    <section
      id="signup-section"
      class="newsletter-section mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8"
    >
      <Newsletter />
    </section>
    -->
  </main>

  <Footer />
</Layout>

<style>
  .section-label {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .community-section {
    background: white;
  }

  .community-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }

  @media (min-width: 768px) {
    .community-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .community-card {
    background: var(--color-bg-soft);
    padding: 2rem;
    border-radius: 12px;
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }

  .community-card:hover {
    border-color: var(--color-primary-light);
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(247, 127, 0, 0.1);
  }

  .community-icon {
    width: 3rem;
    height: 3rem;
    background: linear-gradient(135deg, var(--color-primary), var(--color-accent));
    color: white;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .community-icon svg {
    width: 1.75rem;
    height: 1.75rem;
  }

  .community-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .community-card-text {
    color: var(--color-text-secondary);
    line-height: 1.7;
    font-size: 1rem;
  }

  .newsletter-section {
    background: linear-gradient(
      135deg,
      var(--color-bg-soft) 0%,
      var(--color-bg-cream) 100%
    );
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
</style>
