---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { communityStats } from "../config/community";
---

<Layout title="Agentic Hamburg - Community for AI Agent Builders">
  <Header />

  <!-- Conference Banner -->
  <a href="/conf-2026" class="conf-banner">
    <div class="banner-content">
      <span class="banner-badge">March 22, 2026</span>
      <span class="banner-text">Agentic Conf Hamburg — Tickets now available</span>
      <svg class="banner-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M5 12h14M12 5l7 7-7 7" />
      </svg>
    </div>
  </a>

  <main>
    <!-- Hero Section -->
    <section class="hero">
      <div class="hero-bg">
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
        <div class="hero-pattern"></div>
      </div>

      <div class="hero-content">
        <h1 class="hero-title">
          <span class="title-line">Agentic</span>
          <span class="title-line title-gradient">Hamburg</span>
        </h1>

        <p class="hero-tagline">
          Software engineering is being rewritten — how you code, how your team works, how your company ships. No playbook exists yet. We're writing it together.
        </p>

        <div class="hero-stats">
          <div class="hero-stat">
            <span class="stat-number">{communityStats.memberCount}</span>
            <span class="stat-text">members</span>
          </div>
          <div class="stat-separator"></div>
          <div class="hero-stat">
            <span class="stat-number">{communityStats.meetupCount}</span>
            <span class="stat-text">sold-out events</span>
          </div>
          <div class="stat-separator"></div>
          <div class="hero-stat">
            <span class="stat-number">4.8<span class="stat-star">★</span></span>
            <span class="stat-text">avg rating</span>
          </div>
        </div>
      </div>

      <div class="scroll-indicator">
        <span>Explore</span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 14l-7 7m0 0l-7-7m7 7V3" />
        </svg>
      </div>
    </section>

    <!-- Activities Section -->
    <section class="activities-section">
      <div class="section-container">
        <div class="section-header">
          <span class="section-label">What's Happening</span>
          <h2 class="section-title">Join the Movement</h2>
        </div>

        <div class="activities-grid">
          <!-- Conference Card -->
          <article class="activity-card card-conference">
            <div class="card-glow"></div>
            <div class="card-content">
              <div class="card-badge">
                <span class="badge-live"></span>
                Tickets Available
              </div>

              <div class="card-date">
                <svg class="date-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="3" y="4" width="18" height="18" rx="2" />
                  <path d="M16 2v4M8 2v4M3 10h18" />
                </svg>
                March 22, 2026
              </div>

              <h3 class="card-title">
                Agentic Conf<br />Hamburg 2026
              </h3>

              <p class="card-description">
                A full-day conference with talks, live demos, workshops, and networking. The biggest agentic AI event in Northern Germany.
              </p>

              <div class="card-venue">
                <svg class="venue-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                  <circle cx="12" cy="10" r="3" />
                </svg>
                <span>Medienbunker · SAE Institute Hamburg</span>
              </div>

              <div class="card-actions">
                <a href="https://lu.ma/45lfeyeh" target="_blank" rel="noopener noreferrer" class="btn-primary">
                  <span>Get Tickets</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
                <a href="/conf-2026" class="btn-ghost">
                  Learn more
                </a>
              </div>
            </div>
          </article>

          <!-- Meetups Card -->
          <article class="activity-card card-meetups">
            <div class="card-content">
              <div class="card-badge badge-muted">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="badge-icon">
                  <path d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                Regular Events
              </div>

              <h3 class="card-title card-title-small">
                Agentic Coding<br />Meetup
              </h3>

              <p class="card-description">
                Regular meetups for talks, demos, and networking with Hamburg's agentic coding community.
              </p>

              <div class="card-metrics">
                <div class="metric">
                  <span class="metric-value">{communityStats.meetupCount}</span>
                  <span class="metric-label">events</span>
                </div>
                <div class="metric">
                  <span class="metric-value">400+</span>
                  <span class="metric-label">attendees</span>
                </div>
                <div class="metric">
                  <span class="metric-value">78</span>
                  <span class="metric-label">reviews</span>
                </div>
              </div>

              <div class="card-actions">
                <a href="/meetups" class="btn-secondary">
                  <span>View Meetups</span>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Social Proof Section -->
    <section class="proof-section">
      <div class="section-container">
        <div class="proof-header">
          <span class="section-label">Community Feedback</span>
          <h2 class="section-title">What People Say</h2>
        </div>

        <div class="testimonial-marquee">
          <div class="marquee-track">
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Engaging and informative sessions"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Welcoming community atmosphere"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Good vibes, great people"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Made a real impact on my work"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Met amazing new people"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Perfect venue and setting"</p>
            </div>
            <!-- Duplicate for seamless loop -->
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Engaging and informative sessions"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Welcoming community atmosphere"</p>
            </div>
            <div class="testimonial-card">
              <div class="testimonial-rating">★★★★★</div>
              <p class="testimonial-text">"Good vibes, great people"</p>
            </div>
          </div>
        </div>

        <div class="proof-summary">
          <div class="summary-stat">
            <span class="summary-value">4.8</span>
            <span class="summary-label">Average Rating</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-stat">
            <span class="summary-value">78</span>
            <span class="summary-label">Reviews</span>
          </div>
          <div class="summary-divider"></div>
          <div class="summary-stat">
            <span class="summary-value">100%</span>
            <span class="summary-label">Sold-Out Events</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA Section -->
    <section class="cta-section">
      <div class="cta-bg">
        <div class="cta-glow"></div>
      </div>
      <div class="section-container">
        <div class="cta-content">
          <h2 class="cta-title">Ready to Build?</h2>
          <p class="cta-text">
            Join Hamburg's most active AI agent community. Conference tickets are limited.
          </p>
          <div class="cta-actions">
            <a href="https://lu.ma/45lfeyeh" target="_blank" rel="noopener noreferrer" class="btn-cta">
              <span>Get Conference Tickets</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== CONFERENCE BANNER ===== */
  .conf-banner {
    display: block;
    position: relative;
    z-index: 40;
    background: linear-gradient(135deg, var(--color-primary) 0%, #ff8c00 100%);
    color: white;
    text-decoration: none;
    padding: 0.75rem 1rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .conf-banner:hover {
    background: linear-gradient(135deg, #e67300 0%, var(--color-primary) 100%);
  }

  .banner-content {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .banner-badge {
    background: rgba(255, 255, 255, 0.2);
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .banner-text {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .banner-arrow {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .conf-banner:hover .banner-arrow {
    transform: translateX(4px);
  }

  @media (max-width: 500px) {
    .banner-badge {
      display: none;
    }
  }

  /* ===== HERO SECTION ===== */
  .hero {
    position: relative;
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: visible;
    padding: 2rem 2rem 4rem;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(165deg, #fdfbf9 0%, #fef6ee 50%, #fff8f2 100%);
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .hero-glow-1 {
    width: 600px;
    height: 600px;
    background: linear-gradient(135deg, rgba(247, 127, 0, 0.15), rgba(255, 159, 28, 0.1));
    top: -200px;
    right: -100px;
  }

  .hero-glow-2 {
    width: 500px;
    height: 500px;
    background: linear-gradient(135deg, rgba(255, 159, 28, 0.1), rgba(247, 127, 0, 0.08));
    bottom: -150px;
    left: -100px;
  }

  .hero-pattern {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23f77f00' fill-opacity='0.03'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
  }

  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
    max-width: 900px;
    overflow: visible;
  }

  .hero-title {
    font-size: clamp(4rem, 15vw, 8rem);
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
    padding-bottom: 0.1em;
  }

  .title-line {
    display: block;
    color: var(--color-text-primary);
  }

  .title-gradient {
    background: linear-gradient(135deg, var(--color-primary) 0%, #ff6b00 50%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-tagline {
    font-size: clamp(1.1rem, 2.5vw, 1.35rem);
    line-height: 1.6;
    color: var(--color-text-secondary);
    max-width: 680px;
    margin: 0 auto 3rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .hero-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text-primary);
    line-height: 1;
  }

  .stat-star {
    color: var(--color-accent);
    margin-left: 2px;
  }

  .stat-text {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-secondary);
  }

  .stat-separator {
    width: 1px;
    height: 40px;
    background: linear-gradient(180deg, transparent, rgba(247, 127, 0, 0.3), transparent);
  }

  @media (max-width: 600px) {
    .stat-separator { display: none; }
    .hero-stats { gap: 1.5rem; }
  }

  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    opacity: 0.6;
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-indicator svg {
    width: 20px;
    height: 20px;
  }

  @keyframes bounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  /* ===== SECTION STYLES ===== */
  .section-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .section-label {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    margin-bottom: 0.75rem;
  }

  .section-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  /* ===== ACTIVITIES SECTION ===== */
  .activities-section {
    padding: 6rem 0;
    background: white;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .activities-grid {
      grid-template-columns: 1fr;
    }
  }

  .activity-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .activity-card:hover {
    transform: translateY(-8px);
  }

  .card-conference {
    background: linear-gradient(145deg, #fffaf5 0%, #fff5eb 100%);
    border: 2px solid var(--color-primary);
    box-shadow: 0 4px 30px rgba(247, 127, 0, 0.1);
  }

  .card-conference:hover {
    box-shadow: 0 20px 60px rgba(247, 127, 0, 0.2);
  }

  .card-conference .card-glow {
    position: absolute;
    top: -50%;
    right: -50%;
    width: 100%;
    height: 100%;
    background: radial-gradient(circle, rgba(247, 127, 0, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .card-meetups {
    background: var(--color-bg-soft);
    border: 2px solid rgba(0, 0, 0, 0.06);
  }

  .card-meetups:hover {
    border-color: rgba(247, 127, 0, 0.2);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
  }

  .card-content {
    position: relative;
    padding: 2.5rem;
  }

  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    background: rgba(247, 127, 0, 0.1);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    margin-bottom: 1.25rem;
  }

  .badge-live {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.2); }
  }

  .badge-muted {
    background: rgba(0, 0, 0, 0.05);
    color: var(--color-text-secondary);
  }

  .badge-icon {
    width: 14px;
    height: 14px;
  }

  .card-date {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .date-icon {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
  }

  .card-title {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text-primary);
    margin-bottom: 1rem;
  }

  .card-title-small {
    font-size: clamp(1.5rem, 3vw, 1.75rem);
  }

  .card-description {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    margin-bottom: 1.25rem;
  }

  .card-venue {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 1.75rem;
  }

  .venue-icon {
    width: 18px;
    height: 18px;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .card-metrics {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 1.75rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .metric-value {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-primary);
  }

  .metric-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-secondary);
  }

  .card-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ===== BUTTONS ===== */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, var(--color-primary) 0%, #ff8c00 100%);
    color: white;
    padding: 1rem 1.75rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
    box-shadow: 0 4px 15px rgba(247, 127, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(247, 127, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.2);
  }

  .btn-primary svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: white;
    color: var(--color-primary);
    padding: 1rem 1.75rem;
    border-radius: 12px;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border: 2px solid var(--color-primary);
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(247, 127, 0, 0.05);
    transform: translateY(-2px);
  }

  .btn-secondary svg {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  .btn-secondary:hover svg {
    transform: translateX(4px);
  }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    color: var(--color-text-secondary);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .btn-ghost:hover {
    color: var(--color-primary);
  }

  /* ===== PROOF SECTION ===== */
  .proof-section {
    padding: 6rem 0;
    background: linear-gradient(180deg, #faf8f6 0%, white 100%);
    overflow: hidden;
  }

  .proof-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .testimonial-marquee {
    margin-bottom: 3rem;
    mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 10%, black 90%, transparent);
  }

  .marquee-track {
    display: flex;
    gap: 1.5rem;
    animation: marquee 30s linear infinite;
    width: max-content;
  }

  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .testimonial-card {
    flex-shrink: 0;
    background: white;
    padding: 1.5rem 2rem;
    border-radius: 16px;
